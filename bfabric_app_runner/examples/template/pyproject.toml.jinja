[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{project_name}}"
version = "0.0.1"
requires-python = ">=3.13"
dependencies = [
    "pyyaml",
    "snakemake",
    "polars",
    "bfabric",
    # Keep this pin in sync with `bfabric.app_runner` in app.yml. Left unpinned, uv prefers the newest `bfabric` and
    # quietly resolves whatever older app-runner still accepts it, so this env and the Makefile's runner drift apart.
    "bfabric-app-runner==0.8.0",
    "cyclopts",
    "loguru",
]

[project.optional-dependencies]
test = [
  "pytest>=8.0.0",
  "pytest-mock",
]

[tool.hatch.metadata]
allow-direct-references = true

[tool.hatch.build.targets.sdist]
include = [
    "src/**/*.py",
    "src/**/*.qmd",
    "src/**/*.yml",
    "src/**/*.mako",
    "src/**/Snakefile",
    "src/**/*.smk",
]
